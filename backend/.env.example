# =============================================================================
# Zeramai HR & Employee Onboarding Management System - Environment Config
# =============================================================================

# Database Connection (Development: SQLite | Production: PostgreSQL)
# PostgreSQL example: postgresql://zeramai:zeramaipassword@localhost:5432/zeramai_hr
DATABASE_URL=sqlite:///./zeramai.db

# Authentication Security
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false

# Object Storage Provider ("local" for disk storage | "s3" for AWS S3 / Azure Blob)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=zeramai-hr-documents

# Organization Metadata
COMPANY_NAME=Zeramai Technologies Pvt Ltd
